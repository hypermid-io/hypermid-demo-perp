# ── Server-only secrets ─────────────────────────────────────────────────────
# Hypermid secret key. Used ONLY in app/api/create-*/route.ts (server-side).
# NEVER prefix with NEXT_PUBLIC_ and never log it.
HYPERMID_SK=sk_live_...

# Privy app secret — server-side, verifies user JWTs in /api/create-*.
PRIVY_APP_SECRET=

# Phase 2 — HMAC secret for /api/webhook (from the Hypermid partner dashboard).
# Unset → webhook route returns 503 and accepts nothing.
HYPERMID_WEBHOOK_SECRET=

# Site-wide basic auth password (any username). Unset = disabled (dev only).
# Set this in Vercel for the pilot deployment.
MIDDLEWARE_PASSWORD=

# ── Public (safe to expose in the browser) ──────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_HYPERMID_API_URL=https://api.hypermid.io
